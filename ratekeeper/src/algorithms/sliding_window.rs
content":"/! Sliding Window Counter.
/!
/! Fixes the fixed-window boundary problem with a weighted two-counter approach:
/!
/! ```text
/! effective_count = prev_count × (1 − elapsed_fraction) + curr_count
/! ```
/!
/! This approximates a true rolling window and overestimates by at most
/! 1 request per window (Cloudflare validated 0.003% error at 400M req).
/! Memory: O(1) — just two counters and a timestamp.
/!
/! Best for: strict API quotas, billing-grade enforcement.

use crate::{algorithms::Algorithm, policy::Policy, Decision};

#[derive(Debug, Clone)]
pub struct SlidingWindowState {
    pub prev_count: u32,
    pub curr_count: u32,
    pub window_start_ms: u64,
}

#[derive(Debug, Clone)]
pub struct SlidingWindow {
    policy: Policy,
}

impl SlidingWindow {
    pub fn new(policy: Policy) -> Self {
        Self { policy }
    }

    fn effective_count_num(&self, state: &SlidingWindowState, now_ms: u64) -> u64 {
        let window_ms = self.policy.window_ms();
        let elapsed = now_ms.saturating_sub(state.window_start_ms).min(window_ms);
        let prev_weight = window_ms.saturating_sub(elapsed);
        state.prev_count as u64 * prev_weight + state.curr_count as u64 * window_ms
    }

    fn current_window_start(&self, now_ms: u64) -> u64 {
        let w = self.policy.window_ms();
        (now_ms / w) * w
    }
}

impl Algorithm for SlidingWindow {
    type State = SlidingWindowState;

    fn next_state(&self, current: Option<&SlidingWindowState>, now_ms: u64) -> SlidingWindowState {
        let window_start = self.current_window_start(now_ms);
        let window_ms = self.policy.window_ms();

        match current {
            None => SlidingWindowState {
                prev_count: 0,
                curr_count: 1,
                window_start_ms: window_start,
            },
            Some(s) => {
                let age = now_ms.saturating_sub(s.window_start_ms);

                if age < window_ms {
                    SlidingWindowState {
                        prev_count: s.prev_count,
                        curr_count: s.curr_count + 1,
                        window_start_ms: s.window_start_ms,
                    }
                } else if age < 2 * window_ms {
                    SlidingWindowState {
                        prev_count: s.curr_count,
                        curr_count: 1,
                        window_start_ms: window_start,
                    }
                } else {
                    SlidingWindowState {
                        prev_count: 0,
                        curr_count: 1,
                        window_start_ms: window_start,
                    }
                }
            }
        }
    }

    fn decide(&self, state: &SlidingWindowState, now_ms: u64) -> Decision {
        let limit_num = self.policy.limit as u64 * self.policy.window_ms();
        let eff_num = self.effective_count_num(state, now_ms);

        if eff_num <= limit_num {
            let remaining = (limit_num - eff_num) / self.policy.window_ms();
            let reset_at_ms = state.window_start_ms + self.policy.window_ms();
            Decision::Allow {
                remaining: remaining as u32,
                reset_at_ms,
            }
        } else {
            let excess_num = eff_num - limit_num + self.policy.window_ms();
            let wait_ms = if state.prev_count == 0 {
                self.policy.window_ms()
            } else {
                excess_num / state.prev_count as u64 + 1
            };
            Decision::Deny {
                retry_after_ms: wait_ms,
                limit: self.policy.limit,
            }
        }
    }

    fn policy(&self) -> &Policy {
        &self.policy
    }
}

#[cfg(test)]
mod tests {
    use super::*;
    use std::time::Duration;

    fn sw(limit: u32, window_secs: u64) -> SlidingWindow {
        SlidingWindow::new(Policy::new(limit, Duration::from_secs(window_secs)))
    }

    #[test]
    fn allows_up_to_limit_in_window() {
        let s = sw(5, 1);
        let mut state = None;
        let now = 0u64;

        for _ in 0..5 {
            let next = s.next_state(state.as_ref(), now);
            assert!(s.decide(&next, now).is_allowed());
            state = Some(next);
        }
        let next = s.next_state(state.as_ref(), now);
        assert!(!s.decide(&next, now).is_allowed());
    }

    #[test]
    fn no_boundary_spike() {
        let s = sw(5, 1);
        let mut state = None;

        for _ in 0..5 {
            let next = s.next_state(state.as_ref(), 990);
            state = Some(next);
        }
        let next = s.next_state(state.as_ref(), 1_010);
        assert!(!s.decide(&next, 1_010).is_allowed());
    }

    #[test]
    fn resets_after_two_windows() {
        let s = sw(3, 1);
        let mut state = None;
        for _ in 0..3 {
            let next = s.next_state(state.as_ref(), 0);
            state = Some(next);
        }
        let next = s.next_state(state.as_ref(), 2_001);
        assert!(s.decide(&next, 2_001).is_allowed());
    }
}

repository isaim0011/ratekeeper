//! Token Bucket algorithm.
//!
//! State: `{ tokens: f64, last_refill_ms: u64 }`
//! Refill rate: `policy.limit` tokens per `policy.window`.
//! Capacity (max burst): `policy.limit + policy.burst`.
//!
//! Explicit burst capacity makes this more intuitive to tune than GCRA
//! for per-user API keys where short spikes are acceptable.

use crate::{algorithms::Algorithm, policy::Policy, Decision};

const SCALE: u64 = 1_000_000;

#[derive(Debug, Clone)]
pub struct TokenBucketState {
    /// Available tokens scaled by `SCALE` to avoid float math in the hot path.
    pub tokens_scaled: u64,
    pub last_refill_ms: u64,
}

#[derive(Debug, Clone)]
pub struct TokenBucket {
    policy: Policy,
    capacity: u64,
    refill_per_ms: u64,
}

impl TokenBucket {
    pub fn new(policy: Policy) -> Self {
        let capacity = (policy.limit + policy.burst) as u64 * SCALE;
        let refill_per_ms = match (policy.limit as u64 * SCALE).checked_div(policy.window_ms()) {
            Some(v) => v,
            None => 0,
        };
        Self {
            policy,
            capacity,
            refill_per_ms,
        }
    }

    fn refill(&self, state: &TokenBucketState, now_ms: u64) -> u64 {
        let elapsed = now_ms.saturating_sub(state.last_refill_ms);
        (state.tokens_scaled + elapsed * self.refill_per_ms).min(self.capacity)
    }
}

impl Algorithm for TokenBucket {
    type State = TokenBucketState;

    fn next_state(&self, current: Option<&TokenBucketState>, now_ms: u64) -> TokenBucketState {
        match current {
            None => TokenBucketState {
                tokens_scaled: self.capacity.saturating_sub(SCALE),
                last_refill_ms: now_ms,
            },
            Some(s) => {
                let after_refill = self.refill(s, now_ms);
                let tokens_scaled = if after_refill >= SCALE {
                    after_refill - SCALE
                } else {
                    after_refill
                };
                TokenBucketState {
                    tokens_scaled,
                    last_refill_ms: now_ms,
                }
            }
        }
    }

    fn decide(&self, state: &TokenBucketState, _now_ms: u64) -> Decision {
        if state.tokens_scaled >= SCALE {
            Decision::Allow {
                remaining: (state.tokens_scaled / SCALE) as u32,
                reset_at_ms: 0,
            }
        } else {
            let needed_scaled = SCALE.saturating_sub(state.tokens_scaled);
            let wait_ms = if self.refill_per_ms == 0 {
                u64::MAX
            } else {
                needed_scaled.div_ceil(self.refill_per_ms)
            };
            Decision::Deny {
                retry_after_ms: wait_ms,
                limit: self.policy.limit,
            }
        }
    }

    fn policy(&self) -> &Policy {
        &self.policy
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::time::Duration;

    fn tb(limit: u32, window_secs: u64, burst: u32) -> TokenBucket {
        TokenBucket::new(Policy::new(limit, Duration::from_secs(window_secs)).with_burst(burst))
    }

    #[test]
    fn allows_full_bucket_on_first_request() {
        let t = tb(10, 1, 0);
        let s = t.next_state(None, 0);
        assert!(t.decide(&s, 0).is_allowed());
        assert_eq!(s.tokens_scaled / SCALE as u64, 9); // 10 capacity - 1 consumed
    }

    #[test]
    fn denies_when_empty() {
        let t = tb(2, 1, 0);
        let mut state = None;
        let now = 0u64;
        for _ in 0..2 {
            let next = t.next_state(state.as_ref(), now);
            state = Some(next);
        }
        let next = t.next_state(state.as_ref(), now);
        assert!(!t.decide(&next, now).is_allowed());
    }

    #[test]
    fn refills_over_time() {
        let t = tb(10, 1, 0);
        let mut state = None;
        for _ in 0..10 {
            let next = t.next_state(state.as_ref(), 0);
            state = Some(next);
        }
        let next = t.next_state(state.as_ref(), 500);
        assert!(t.decide(&next, 500).is_allowed());
        if let Decision::Allow { remaining, .. } = t.decide(&next, 500) {
            assert!(remaining >= 3, "expected ~4 remaining, got {remaining}");
        }
    }

    #[test]
    fn burst_increases_capacity() {
        let t = tb(5, 1, 5);
        let s = t.next_state(None, 0);
        assert_eq!(s.tokens_scaled / SCALE, 9); // 10 - 1
    }
}
